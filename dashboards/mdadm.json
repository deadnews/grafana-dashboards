      "panel-13": {
        "kind": "Panel",
        "spec": {
          "id": 13,
          "title": "State",
          "description": "Array activity reported by `/proc/mdstat`.\n- `check` — scheduled scrub, redundancy intact\n- `resync` — parity rewrite, usually after an unclean shutdown\n- `recovering` — rebuild onto a replaced or spare disk",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(node_md_state{instance=~\"$hostname\",device=\"$md\",state=\"check\"})\n+ 2 * sum(node_md_state{instance=~\"$hostname\",device=\"$md\",state=\"resync\"})\n+ 3 * sum(node_md_state{instance=~\"$hostname\",device=\"$md\",state=\"recovering\"})\n+ 4 * sum(node_md_state{instance=~\"$hostname\",device=\"$md\",state=\"inactive\"})",
                        "legendFormat": "$md",
                        "range": true
                      },
                      "labels": {
                        "grafana.app/export-label": "prometheus-1",
                        "grafana.app/export-datasource-name": "Mimir Linux"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
